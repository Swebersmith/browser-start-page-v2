{
  "name": "browser-start-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "wrangler deploy",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:vercel": "npm run build && vercel --prod",
    "db:migrate": "wrangler d1 migrations apply browser-start-page-db --remote"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.33.5",
    "vercel": "^44.0.0",
    "wrangler": "^4.0.0"
  }
}
